{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://one-person-lab.dev/contracts/app-webui-release-carrier.schema.json",
  "title": "One Person Lab WebUI Release Carrier",
  "oneOf": [
    { "$ref": "#/$defs/build_input" },
    { "$ref": "#/$defs/carrier_receipt" }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "git_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "release_version": {
      "type": "string",
      "pattern": "^[0-9]{2}\\.(?:[1-9]|1[0-2])\\.(?:[1-9]|[12][0-9]|3[01])(?:-r[1-9][0-9]*|-preview\\.r[1-9][0-9]*|-nightly(?:\\.r[1-9][0-9]*)?)?$"
    },
    "release_identity": {
      "type": "object",
      "required": ["version", "bundle_digest", "cohort_ref"],
      "properties": {
        "version": { "$ref": "#/$defs/release_version" },
        "bundle_digest": { "$ref": "#/$defs/digest" },
        "cohort_ref": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "cohort": {
      "type": "object",
      "required": ["app_sha", "shell_sha", "framework_sha"],
      "properties": {
        "app_sha": { "$ref": "#/$defs/git_sha" },
        "shell_sha": { "$ref": "#/$defs/git_sha" },
        "framework_sha": { "$ref": "#/$defs/git_sha" }
      },
      "additionalProperties": false
    },
    "source_cutoff": {
      "type": "object",
      "required": [
        "observed_at",
        "policy",
        "frozen_base_release_set",
        "post_freeze_remote_refresh_allowed",
        "later_authority_advancement_invalidates_bundle"
      ],
      "properties": {
        "observed_at": { "type": "string", "format": "date-time" },
        "policy": { "const": "single_read_at_freeze_admission" },
        "frozen_base_release_set": { "type": "null" },
        "post_freeze_remote_refresh_allowed": { "const": false },
        "later_authority_advancement_invalidates_bundle": { "const": false }
      },
      "additionalProperties": false
    },
    "platform": {
      "type": "object",
      "required": ["os", "architecture"],
      "properties": {
        "os": { "const": "linux" },
        "architecture": { "const": "amd64" }
      },
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "required": ["id", "ref", "digest", "size_bytes"],
      "properties": {
        "id": {
          "enum": [
            "app_source",
            "shell_webui_source",
            "dockerfile",
            "framework_seed",
            "codex_cli",
            "base_image",
            "qualification_harness"
          ]
        },
        "ref": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" },
        "size_bytes": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "build_input": {
      "type": "object",
      "required": [
        "schema",
        "release",
        "source_cutoff",
        "cohort",
        "platform",
        "inputs",
        "content_fingerprint"
      ],
      "properties": {
        "schema": { "const": "opl_app_webui_build_input.v1" },
        "release": { "$ref": "#/$defs/release_identity" },
        "source_cutoff": { "$ref": "#/$defs/source_cutoff" },
        "cohort": { "$ref": "#/$defs/cohort" },
        "platform": { "$ref": "#/$defs/platform" },
        "inputs": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": { "$ref": "#/$defs/input" }
        },
        "content_fingerprint": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "carrier": {
      "type": "object",
      "required": [
        "carrier_id",
        "carrier_kind",
        "package_profile",
        "ref",
        "digest",
        "size_bytes",
        "content_fingerprint",
        "os",
        "architecture"
      ],
      "properties": {
        "carrier_id": { "const": "docker_webui" },
        "carrier_kind": { "const": "oci_image" },
        "package_profile": { "const": "webui-full" },
        "ref": {
          "type": "string",
          "pattern": "^[a-z0-9.-]+(?::[0-9]+)?/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$"
        },
        "digest": { "$ref": "#/$defs/digest" },
        "size_bytes": { "type": "integer", "minimum": 1 },
        "content_fingerprint": { "$ref": "#/$defs/digest" },
        "os": { "const": "linux" },
        "architecture": { "const": "amd64" }
      },
      "additionalProperties": false
    },
    "qualification": {
      "type": "object",
      "required": [
        "schema",
        "status",
        "build_stage",
        "qualification_stage",
        "image_digest",
        "build_input_digest",
        "content_fingerprint",
        "runtime_summary_sha256",
        "registry_readback_sha256",
        "runtime_image_id"
      ],
      "properties": {
        "schema": { "const": "opl_app_webui_runtime_qualification.v1" },
        "status": { "const": "passed" },
        "build_stage": { "const": "webui_built" },
        "qualification_stage": { "const": "webui_qualified" },
        "image_digest": { "$ref": "#/$defs/digest" },
        "build_input_digest": { "$ref": "#/$defs/digest" },
        "content_fingerprint": { "$ref": "#/$defs/digest" },
        "runtime_summary_sha256": { "$ref": "#/$defs/digest" },
        "registry_readback_sha256": { "$ref": "#/$defs/digest" },
        "runtime_image_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "carrier_receipt": {
      "type": "object",
      "required": [
        "schema",
        "release",
        "source_cutoff",
        "cohort",
        "build_input",
        "carrier",
        "qualification"
      ],
      "properties": {
        "schema": { "const": "opl_app_webui_release_carrier.v1" },
        "release": { "$ref": "#/$defs/release_identity" },
        "source_cutoff": { "$ref": "#/$defs/source_cutoff" },
        "cohort": { "$ref": "#/$defs/cohort" },
        "build_input": {
          "type": "object",
          "required": ["schema", "manifest_digest", "content_fingerprint"],
          "properties": {
            "schema": { "const": "opl_app_webui_build_input.v1" },
            "manifest_digest": { "$ref": "#/$defs/digest" },
            "content_fingerprint": { "$ref": "#/$defs/digest" }
          },
          "additionalProperties": false
        },
        "carrier": { "$ref": "#/$defs/carrier" },
        "qualification": { "$ref": "#/$defs/qualification" }
      },
      "additionalProperties": false
    }
  }
}
