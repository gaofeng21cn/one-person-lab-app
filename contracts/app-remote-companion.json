  },
  "pairing": {
    "user_flow": "obtain_invitation_then_desktop_start_pairing_then_ios_scan_one_time_qr_then_compare_authentication_string_then_desktop_confirm_then_activate_d1_device_authorization_then_issue_short_lived_ably_jwt_then_ios_enters_companion_after_canonical_refresh",
    "account_required": false,
    "primary_method": "one_time_qr",
    "fallback_method": "short_manual_code_or_paste_full_pairing_payload",
    "fallback_payload_policy": "both_entry_methods_bind_to_the_same_single_use_short_lived_pairing_record_without_creating_a_second_pairing_state",
    "short_manual_code": "target_via_configured_worker_origin_then_normal_claim_current_legacy_source_requires_migration",
    "manual_code_resolution": {
      "configured_origin": "signed_ios_carrier_configuration",
      "endpoint": "/v1/remote-companion/pairings/resolve",
      "availability": "reserved_pairing_before_first_claim_only",
      "response_fields": [
        "pairing_id",
        "service_url",
        "desktop_public_key",
        "expires_at"
      ],
      "response_must_not_include": [
        "claim_secret",
        "desktop_pair_token",
        "ios_claim_token",
        "provider_credential"
      ],
      "claim_behavior": "reuse_the_same_manual_code_with_the_resolved_pairing_id_in_the_existing_claim_protocol"
    },
    "qr_payload": [
      "service_url",
      "opaque_pairing_id",
      "one_time_random_256_bit_qr_claim_secret",
      "desktop_pair_specific_public_key",
      "short_lived_pairing_expiry"
    ],
    "qr_payload_must_not_include": [
      "provider_secret_or_api_key",
      "desktop_public_ip_or_port",
      "workspace_path",
      "conversation_text",
      "long_lived_access_token",
      "plaintext_pair_master_key"
    ],
    "claim_protocol": [
      "worker_validates_one_time_invitation_and_atomically_reserves_one_configured_pair_admission_in_d1",
      "desktop_creates_single_use_pairing_record_random_256_bit_qr_claim_secret_and_pair_specific_x25519_keypair",
      "worker_stores_only_a_keyed_hash_of_the_qr_claim_secret_and_the_qr_carries_the_plaintext_secret_once",
      "ios_creates_a_pair_specific_x25519_keypair_and_submits_pairing_id_claim_secret_and_public_key_to_the_worker",
      "desktop_reads_the_claim_and_both_devices_display_the_same_short_authentication_string_derived_from_pairing_id_and_both_public_keys",
      "desktop_requires_local_confirmation_after_the_user_compares_the_short_authentication_string",
      "desktop_and_ios_derive_the_pair_master_key_locally_with_x25519_and_hkdf_without_transmitting_it",
      "desktop_pair_token_and_ios_claim_token_become_role_bound_active_device_credentials_after_activation_and_d1_stores_only_their_hashes",
      "worker_activates_pair_specific_device_authorizations_and_key_epoch_then_issues_provider_scoped_short_lived_opaque_transport_credentials",
      "ios_enables_commands_only_after_transport_connection_and_desktop_canonical_refresh_both_succeed"
    ],
    "control_plane_persistence": {
      "owner": "opl-link/service_on_cloudflare_d1",
      "allowed": [
        "opaque_invitation_entitlement_or_hash",
        "opaque_pairing_id",
        "keyed_hash_of_single_use_claim_secret_or_manual_code",
        "pair_specific_public_keys",
        "expiry_claim_and_pair_admission_state",
        "opaque_transport_identity_and_key_epoch",
        "device_credential_hashes",
        "revoked_device_hash",
        "push_registration_reference_without_notification_content"
      ],
      "forbidden": [
        "conversation_history",
        "conversation_content",
        "workspace_files",
        "provider_secret_or_api_key_in_client_records",
        "plaintext_pair_master_key",
        "plaintext_device_credential",
        "plaintext_invitation_secret"
      ],
      "atomic_claim_and_pair_admission_required": true,
      "retention": "delete_unclaimed_records_after_expiry_and_delete_revoked_pair_metadata_after_bounded_security_retention"
    },
    "ios_pending_pairing_persistence": {
      "owner": "opl-link",
      "storage": "ios_keychain_when_unlocked_this_device_only_until_activation_expiry_or_local_reset",
      "material": [
        "opaque_pairing_id",
        "service_url",
        "ios_device_id",
        "ios_pair_specific_private_key",
        "desktop_pair_specific_public_key",
        "ios_claim_token",
        "authentication_string",
        "short_lived_pairing_expiry"
      ],
      "resume": "cold_start_restores_awaiting_desktop_confirmation_and_reads_worker_state_without_reclaiming_or_reminting_pair_credentials",
      "activation": "persist_active_pair_material_with_the_existing_ios_claim_token_before_transport_connect_then_delete_the_pending_record",
      "clear_on": [
        "active_pair_material_persisted_after_activation",
        "pairing_expiry",
        "failed_claim",
        "terminal_revocation"
      ]
    },
    "admission_lifecycle": {
      "owner": "opl-link/service_on_cloudflare_workers_and_d1",
      "pair_admission_definition": "one_authorized_desktop_and_ios_device_pair",
      "reservation_ttl_minutes": 5,
      "allocated_states": [
        "reserved",
        "awaiting_desktop_confirmation",
        "activating",
        "active",
        "revoking"
      ],
        "limit_source": "release_cohort_lock_active_pair_limit_20_with_warning_at_15",
      "release_condition": "d1_pair_is_terminally_revoked_device_token_renewal_is_denied_and_desktop_connector_is_detached",
      "client_must_not_allocate_reclaim_or_infer_capacity": true
    },
    "device_lifecycle": {
      "mvp_max_active_companion_pairs_per_desktop_installation": 1,
      "device_label_user_editable": true,
      "revoke_action": "desktop_or_ios_explicit_revoke_pair",
      "revoke_effect": "mark_pair_revoked_in_d1_deny_future_jwt_issuance_detach_desktop_delete_pair_keys_remove_push_registration_rotate_or_retire_channel_epoch_and_clear_ios_material",
        "existing_token_policy": "a_short_lived_provider_transport_credential_may_remain_cryptographically_valid_until_expiry_but_desktop_detach_and_deleted_pair_keys_must_reject_all_commands_immediately",
      "provider_user_account_deletion_required": false,
      "repair_required_after_provider_switch": true
    }
  },
