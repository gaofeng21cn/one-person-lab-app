{
  "schema": "opl_app_remote_companion_wire.v2",
  "owner": "one-person-lab-app",
  "state": "frozen_source_baseline_live_qualification_pending",
  "protocol_version": "opl_remote_transport.v1",
  "contract_boundary": "This contract owns the target cross-repository OPL Link control-plane HTTP and encrypted transport wire shape. It selects Ably plus Cloudflare Workers and D1 as the current target without claiming that iOS, desktop, service, provider, network, APNs, or TestFlight qualification is complete. OPL Cloud, a user-managed server, Cloudflare Tunnel, and provider history are not runtime or release authorities.",
  "service_owner": "opl-link/service",
  "target_runtime": {
    "control_plane_compute": "cloudflare_workers_free",
    "control_plane_persistence": "cloudflare_d1_free",
    "realtime_provider": "ably_free",
    "always_on_application_server_required": false,
    "local_resident_service_required": false,
    "cloudflare_tunnel_required": false
  },
  "compatibility": {
    "version_field_required": true,
    "supported_versions": [
      "opl_remote_transport.v1"
    ],
    "unknown_version_policy": "reject_before_decryption_or_action_dispatch",
    "unknown_action_policy": "reject_without_forwarding_to_the_canonical_action_bridge",
    "manual_code": {
      "status": "short_code_user_fallback",
      "client_behavior": "resolve_through_the_configured_ios_worker_origin_then_reuse_the_same_code_in_the_existing_claim_request",
      "resolution_eligibility": "reserved_pairing_before_first_claim_only"
    },
    "legacy_transport_identifiers": {
      "status": "v1_wire_aliases_only",
      "action_prefix": "canonical_task",
      "event_prefix": "task",
      "product_object": "canonical_codex_conversation",
      "product_semantics_source": "contracts/app-remote-companion.json#surface_boundary.conversation_model",
      "must_not_be_interpreted_as": "opl_link_task_control_plane_or_task_lifecycle_authority"
    }
  },
  "app_access_projection": {
    "view_type": "remote_companion_access",
    "result_schema_ref": "contracts/opl-app-contributions.schema.json#/$defs/remote_companion_access_result",
    "status_values": [
      "unavailable",
      "unpaired",
      "reserving",
      "qr_ready",
      "awaiting_confirmation",
      "active",
      "revoking",
      "attention"
    ],
    "actions": [
      "pair.start",
      "pair.refresh",
      "pair.confirm",
      "pair.cancel",
      "device.rename",
      "pair.revoke"
    ],
    "secret_policy": {
      "transient_only": [
        "invitation_code",
        "manual_code",
        "qr_payload",
        "authentication_digits"
      ],
      "never_in_cache_log_or_app_action_readback": [
        "invitation_code",
        "manual_code",
        "claim_secret",
        "claim_material"
      ],
      "qr_payload_only_when": "status_equals_qr_ready",
      "qr_payload_max_length": 8192
    },
    "wire_alias_policy": "opl_remote_transport.v1_is_an_internal_wire_compatibility_alias_only; product_model_uses_conversation_and_canonical_thread"
  },
  "serialization": {
    "media_type": "application/json",
    "field_names": "lower_snake_case",
    "binary_encoding": "unpadded_base64url",
    "timestamp_encoding": "rfc3339_utc",
    "opaque_identifier_encoding": "uuid_v4_or_128_bit_random_base64url",
    "maximum_encrypted_transport_message_bytes": 65536
  },
  "control_plane_http": {
    "base_path": "/v1/remote-companion",
    "tls_required": true,
    "mutation_idempotency_header": "Idempotency-Key",
    "authorization_header": "Authorization: Bearer <opaque_token>",
    "tokens": {
      "desktop_pair_token": "single_pairing_desktop_poll_and_confirmation_then_desktop_active_device_credential_after_activation",
      "ios_claim_token": "single_pairing_ios_poll_then_ios_active_device_credential_after_activation",
      "active_device_credential": "role_bound_to_the_callers_existing_desktop_pair_token_or_ios_claim_token_after_activation_without_minting_a_second_bearer",
      "revoked_desktop_credential_scope": "after_revoke_the_existing_desktop_credential_can_only_submit_the_matching_desktop_detach_ack_and_cannot_access_any_other_route",
      "revocation_receipt_token": "single_revocation_status_read_only_until_terminal_or_expiry",
      "storage": "store_only_sha256_or_server_keyed_hashes_in_d1_and_return_plaintext_once",
      "transport": "bearer_header_only_never_url_query_or_qr"
    },
    "release_cohort_lock": {
      "source": "opl-link/release-cohort.json",
      "product_contract_ref": "contracts/app-remote-companion.json#transport.release_cohort_lock",
      "owner": "opl-link/service",
      "source_status": "source_integrated_validation_placeholder_not_live_qualified",
      "metadata_match_required_before_pairing": true,
      "match_fields": [
        "environment",
        "cohort_id",
        "protocol_version",
        "provider",
        "service_origin",
        "config_digest"
      ],
      "config_summary_match_required": true,
      "config_digest_match_required": true,
      "expected_validation_cohort": {
        "environment": "validation",
        "cohort_id": "ably-validation-20260819",
        "protocol_version": "opl_remote_transport.v1",
        "provider": "ably",
        "service_origin": "https://validation.invalid",
        "deployment_state": "not_live_qualified",
        "active_pair_limit": 20,
        "warning_threshold": 15
      },
      "admission_authority": "opl-link/service_cloudflare_worker_and_d1",
      "limit_scope": "validation_cohort_not_provider_seat_limit",
      "fixed_provider_seat_limit": false,
      "mismatch_policy": "fail_closed_before_claim_or_transport_connection"
    },
    "endpoints": [
      {
        "id": "service_health",
        "method": "GET",
        "path": "/healthz",
        "auth": "none",
        "idempotency_required": false,
        "proof_scope": "worker_process_reachable_only",
        "response_fields": [
          "status"
        ]
      },
      {
        "id": "service_metadata",
        "method": "GET",
        "path": "/metadata",
        "auth": "none",
        "idempotency_required": false,
        "response_fields": [
          "protocol_version",
          "provider",
          "environment",
          "cohort_id",
          "service_origin",
          "service_origin_source",
          "deployment_state",
          "config_summary",
          "config_digest"
        ]
      },
      {
        "id": "service_readiness",
        "method": "GET",
        "path": "/readyz",
        "auth": "operator_bearer_from_OPL_LINK_OPERATOR_TOKEN",
        "idempotency_required": false,
        "proof_scope": "d1_read_write_and_scoped_ably_jwt_issuance",
        "response_fields": [
          "status",
          "protocol_version",
          "database_read",
          "database_write",
          "scoped_jwt_issuance",
          "provider",
          "active_pair_count"
        ],
        "response_must_not_include": [
          "capability_token",
          "transport_credential",
          "ably_api_key",
          "operator_token"
        ]
      },
      {
        "id": "operator_create_invitation",
        "method": "POST",
        "path": "/v1/remote-companion/invitations",
        "auth": "operator_bearer_from_cloudflare_worker_secret",
        "idempotency_required": true,
        "request_fields": [
          "protocol_version",
          "label",
          "expires_at"
        ],
        "response_fields": [
          "invitation_code",
          "expires_at"
        ],
        "secret_response_fields": [
          "invitation_code"
        ]
      },
      {
        "id": "operator_read_capacity",
        "method": "GET",
        "path": "/v1/remote-companion/capacity",
        "auth": "operator_bearer_from_OPL_LINK_OPERATOR_TOKEN",
        "idempotency_required": false,
        "response_fields": [
          "protocol_version",
          "active_pair_count",
          "active_pair_limit",
          "warning_threshold",
          "warning"
        ]
      },
      {
        "id": "desktop_create_pairing",
        "method": "POST",
        "path": "/v1/remote-companion/pairings",
        "auth": "one_time_invitation_code_in_body",
        "idempotency_required": true,
        "request_fields": [
          "protocol_version",
          "invitation_code",
          "desktop_device_id",
          "desktop_device_label",
          "desktop_public_key"
        ],
        "response_fields": [
          "protocol_version",
          "pairing_id",
          "desktop_pair_token",
          "claim_secret",
          "manual_code",
          "expires_at",
          "service_url"
        ],
        "secret_response_fields": [
          "desktop_pair_token",
          "claim_secret",
          "manual_code"
        ]
      },
      {
        "id": "ios_resolve_manual_pairing",
        "method": "POST",
        "path": "/v1/remote-companion/pairings/resolve",
        "auth": "manual_code_in_body",
        "idempotency_required": true,
        "request_fields": [
          "protocol_version",
          "manual_code"
        ],
        "response_fields": [
          "protocol_version",
          "pairing_id",
          "service_url",
          "desktop_public_key",
          "expires_at"
        ],
        "secret_request_fields": [
          "manual_code"
        ],
        "allowed_pairing_state": "reserved",
        "response_must_not_include": [
          "claim_secret",
          "desktop_pair_token",
          "ios_claim_token",
          "provider_credential"
        ]
      },
      {
        "id": "ios_claim_pairing",
        "method": "POST",
        "path": "/v1/remote-companion/pairings/claim",
        "auth": "claim_secret_or_manual_code_in_body",
        "idempotency_required": true,
        "request_fields": [
          "protocol_version",
          "pairing_id",
          "claim_secret_or_manual_code",
          "ios_device_id",
          "ios_device_label",
          "ios_public_key"
        ],
        "response_fields": [
          "protocol_version",
          "pairing_id",
          "ios_claim_token",
          "state",
          "authentication_string",
          "expires_at"
        ],
        "secret_response_fields": [
          "ios_claim_token"
        ]
      },
      {
        "id": "read_pairing",
        "method": "GET",
        "path": "/v1/remote-companion/pairings/{pairing_id}",
        "auth": "desktop_pair_token_or_ios_claim_token_or_active_device_credential",
        "idempotency_required": false,
        "response_fields": [
          "protocol_version",
          "pairing_id",
          "state",
          "authentication_string",
          "expires_at",
          "device_activation"
        ],
        "pre_active_device_activation": null,
        "device_activation_fields": [
          "device_id",
          "device_label",
          "peer_device_id",
          "peer_device_label",
          "peer_public_key",
          "transport_provider",
          "transport_credential",
          "key_epoch",
          "credential_expires_at",
          "push_recipient_id"
        ],
        "active_device_credential_source": "desktop_pair_token_for_desktop_and_ios_claim_token_for_ios_become_active_after_pair_activation",
        "device_activation_policy": "return_only_the_calling_devices_own_activation_and_the_minimum_peer_route_identity_device_label_and_public_key_required_for_e2ee; pre_active_pairing_returns_null; transport_credential_is_opaque_to_app_shell_framework_and_core_and_decoded_only_by_the_selected_provider_adapter; never_return_or_echo_a_pair_bearer_in_device_activation"
      },
      {
        "id": "desktop_confirm_pairing",
        "method": "POST",
        "path": "/v1/remote-companion/pairings/{pairing_id}/confirm",
        "auth": "desktop_pair_token",
        "idempotency_required": true,
        "request_fields": [
          "protocol_version",
          "authentication_string"
        ],
        "response_fields": [
          "protocol_version",
          "pairing_id",
          "state"
        ]
      },
      {
        "id": "refresh_provider_credentials",
        "method": "POST",
        "path": "/v1/remote-companion/pairings/{pairing_id}/credentials",
        "auth": "active_device_credential",
        "idempotency_required": true,
        "request_fields": [
          "protocol_version",
          "device_id"
        ],
        "response_fields": [
          "protocol_version",
          "transport_provider",
          "transport_credential",
          "key_epoch",
          "credential_expires_at",
          "push_recipient_id"
        ],
        "secret_response_fields": [
          "transport_credential"
        ]
      },
      {
        "id": "rename_own_device",
        "method": "PATCH",
        "path": "/v1/remote-companion/pairings/{pairing_id}/devices/{device_id}",
        "auth": "active_credential_for_the_same_pairing_and_device",
        "idempotency_required": true,
        "request_fields": [
          "protocol_version",
          "display_name"
        ],
        "response_fields": [
          "protocol_version",
          "pairing_id",
          "device_id",
          "display_name"
        ]
      },
      {
        "id": "register_own_push_recipient",
        "method": "PUT",
        "path": "/v1/remote-companion/pairings/{pairing_id}/devices/{device_id}/push-registration",
        "auth": "active_credential_for_the_same_pairing_and_device",
        "idempotency_required": true,
        "request_fields": [
          "protocol_version",
          "push_recipient_id"
        ],
        "forbidden_request_fields": [
          "apns_token",
          "device_token",
          "push_token"
        ],
        "response_fields": [
          "protocol_version",
          "pairing_id",
          "device_id",
          "push_recipient_id"
        ]
      },
      {
        "id": "delete_own_push_recipient",
        "method": "DELETE",
        "path": "/v1/remote-companion/pairings/{pairing_id}/devices/{device_id}/push-registration",
        "auth": "active_credential_for_the_same_pairing_and_device",
        "idempotency_required": true,
        "request_fields": [
          "protocol_version"
        ],
        "response_fields": [
          "protocol_version",
          "pairing_id",
          "device_id",
          "push_recipient_id"
        ]
      },
      {
        "id": "revoke_pair",
        "method": "DELETE",
        "path": "/v1/remote-companion/pairings/{pairing_id}",
        "auth": "active_device_credential_or_desktop_pair_token",
        "idempotency_required": true,
        "request_fields": [
          "protocol_version"
        ],
        "response_fields": [
          "protocol_version",
          "pairing_id",
          "state",
          "revocation_receipt_id",
          "revocation_receipt_token"
        ],
        "secret_response_fields": [
          "revocation_receipt_token"
        ]
      },
      {
        "id": "read_revocation",
        "method": "GET",
        "path": "/v1/remote-companion/revocations/{revocation_receipt_id}",
        "auth": "revocation_receipt_token",
        "idempotency_required": false,
        "response_fields": [
          "protocol_version",
          "pairing_id",
          "state",
          "device_authorization_revoked",
          "token_renewal_denied",
          "desktop_connector_detached",
          "pair_admission_released",
          "detachment_basis"
        ],
        "terminal_rule": "state_is_revoked_and_pair_admission_released_is_true_only_after_d1_denies_future_tokens_and_the_desktop_connector_is_detached"
      },
      {
        "id": "desktop_detach_ack",
        "method": "POST",
        "path": "/v1/remote-companion/revocations/{revocation_receipt_id}/desktop-detach",
        "auth": "matching_revoked_desktop_credential_only",
        "idempotency_required": true,
        "request_fields": [
          "protocol_version",
          "detachment_basis"
        ],
        "detachment_basis_values": [
          "desktop_ack"
        ],
        "response_fields": [
          "protocol_version",
          "pairing_id",
          "state",
          "device_authorization_revoked",
          "token_renewal_denied",
          "desktop_connector_detached",
          "pair_admission_released",
          "detachment_basis"
        ]
      }
    ],
    "pairing_states": [
      "reserved",
      "claimed",
      "awaiting_desktop_confirmation",
      "activating",
      "active",
      "revoking",
      "revoked",
      "expired"
    ],
    "error_envelope": {
      "fields": [
        "protocol_version",
        "error_code",
        "retryable",
        "request_id"
      ],
      "allowed_error_codes": [
