{
  "schema": "opl_link_studio_wire.v2",
  "owner": "one-person-lab-app",
  "implementation_owners": {
    "client": "opl-link",
    "host": "opl-studio"
  },
  "transport": "authenticated_https_json_and_server_sent_events",
  "base_path": "/api/link",
  "origin_policy": "https_with_system_trust; explicit_debug_loopback_http_only",
  "pairing_url": "opllink://pair?endpoint=<percent_encoded_https_base>&code=<single_use_secret>",
  "pairing_ttl_seconds": 120,
  "credential_ttl_days": 30,
  "host_routes": {
    "POST /pair": {
      "auth": "desktop_session_and_csrf",
      "input": {
        "endpoint": "https_base_url"
      },
      "output": [
        "schema",
        "endpoint",
        "code",
        "expiresAt",
        "pairingURL"
      ]
    },
    "POST /claim": {
      "auth": "single_use_pair_code",
      "input": [
        "code",
        "deviceName"
      ],
      "output": [
        "schema",
        "token",
        "expiresAt",
        "device",
        "host"
      ]
    },
    "GET /devices": {
      "auth": "desktop_session",
      "output": {
        "devices": "paired_device_metadata_without_tokens"
      }
    },
    "DELETE /devices/:id": {
      "auth": "desktop_session_and_csrf",
      "effect": "revoke_device_and_close_its_streams"
    }
  },
  "client_routes": {
    "GET /bootstrap": {
      "auth": "device_bearer",
      "output": [
        "schema",
        "host",
        "device",
        "capabilities"
      ]
    },
    "POST /invoke": {
      "auth": "device_bearer",
      "input": [
        "method",
        "payload",
        "requestId"
      ],
      "output": {
        "result": "canonical_owner_response"
      }
    },
    "GET /events": {
      "auth": "device_bearer",
      "output": "sse_data_frames_with_canonical_method_and_params"
    },
    "POST /download": {
      "auth": "device_bearer",
      "input": [
        "threadId",
        "relativePath"
      ],
      "output": "bounded_workspace_file_bytes"
    },
    "POST /disconnect": {
      "auth": "device_bearer",
      "effect": "revoke_this_device"
    }
  },
  "methods": {
    "listThreads": "canonical_thread_directory",
    "readThread": "canonical_thread_and_turns",
    "startTurn": "return_threadId_and_turnId_after_start_without_waiting_for_completion; inherit_existing_thread_settings",
    "steerTurn": "canonical_active_turn_steering",
    "interruptTurn": "canonical_active_turn_interrupt",
    "listPendingServerRequests": "canonical_pending_approvals_and_questions",
    "respondToServerRequest": "validate_pending_id_method_and_response_then_forward_to_existing_owner",
    "readCodexModels": "canonical_model_catalog",
    "listThreadWorkspace": "bounded_canonical_thread_workspace_directory",
    "readThreadWorkspaceFile": "bounded_file_preview",
    "readThreadWorkspaceGit": "canonical_workspace_git_projection",
    "renameThread": "canonical_thread_rename",
    "setArchived": "canonical_thread_archive_or_restore"
  },
  "turn_input": {
    "threadId": "optional_existing_id",
    "prompt": "text",
    "model": "optional_explicit_selection",
    "reasoningEffort": "optional_explicit_selection",
    "attachments": "optional_bounded_name_mimeType_base64_files"
  },
  "steer_input": {
    "threadId": "required_existing_id",
    "expectedTurnId": "required_active_turn_id",
    "prompt": "text",
    "attachments": "optional_bounded_name_mimeType_base64_files",
    "model_or_reasoning_override_allowed": false
  },
  "limits": {
    "control_request_bytes": 16384,
    "invoke_request_bytes": 73400320,
    "attachment_count": 5,
    "attachment_bytes_each": 10485760,
    "download_bytes": 268435456
  },
  "stream_projection": "no_snapshot_cursor; coalesce_text_deltas_into_canonical_thread_reread_instead_of_appending_to_recovery_snapshots",
  "event_policy": "reconnect_then_reread_canonical_snapshots; never_replay_mutations",
  "mutation_policy": "requestId_deduplication_and_conflict_rejection; unknown_outcome_requires_canonical_readback",
  "security": [
    "bearer_scoped_to_companion_routes",
    "hash_device_credentials_at_rest",
    "single_use_expiring_pair_codes",
    "reject_cross_origin_redirects",
    "revoke_closes_live_streams",
    "workspace_realpath_and_symlink_bounds",
    "no_offline_command_queue",
    "no_model_credentials_on_phone"
  ],
  "error": {
    "error": {
      "code": "machine_readable",
      "message": "human_readable",
      "details": "optional_object"
    }
  },
  "desktop_bridge_methods": {
    "readLinkDevices": "desktop_context_only_paired_device_metadata_without_tokens",
    "createLinkPairing": "desktop_context_only_expiring_single_use_qr_material",
    "revokeLinkDevice": "desktop_context_only_revoke_and_disconnect_device"
  }
}
