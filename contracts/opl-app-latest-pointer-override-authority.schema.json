{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://one-person-lab.dev/contracts/opl-app-latest-pointer-override-authority.schema.json",
  "title": "OPL App Latest Pointer Override Authority",
  "type": "object",
  "required": [
    "schema",
    "status",
    "operation",
    "authorization",
    "candidate",
    "compare_and_swap",
    "readback",
    "authority_digest"
  ],
  "properties": {
    "schema": {
      "const": "opl_app_latest_pointer_override_authority.v1"
    },
    "status": {
      "const": "admitted"
    },
    "operation": {
      "const": "move_latest_pointer"
    },
    "authorization": {
      "type": "object",
      "required": [
        "source",
        "protected_environment",
        "single_use",
        "persistent_override"
      ],
      "properties": {
        "source": {
          "const": "user_explicit"
        },
        "protected_environment": {
          "const": "release-preview-latest"
        },
        "single_use": {
          "const": true
        },
        "persistent_override": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "required": [
        "tag",
        "component_manifest_digest",
        "artifact_digest",
        "quality_status",
        "build_trigger",
        "preview_kind",
        "quality_unchanged",
        "non_stable_notice",
        "skipped_gates"
      ],
      "properties": {
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "component_manifest_digest": {
          "$ref": "#/$defs/digest"
        },
        "artifact_digest": {
          "$ref": "#/$defs/digest"
        },
        "quality_status": {
          "enum": [
            "stable",
            "preview"
          ]
        },
        "build_trigger": {
          "enum": [
            "manual",
            "automated"
          ]
        },
        "preview_kind": {
          "enum": [
            "dev",
            "nightly"
          ],
          "type": [
            "string",
            "null"
          ]
        },
        "quality_unchanged": {
          "const": true
        },
        "non_stable_notice": {
          "type": "boolean"
        },
        "skipped_gates": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "compare_and_swap": {
      "type": "object",
      "required": [
        "expected_current_tag",
        "exact_expected_current"
      ],
      "properties": {
        "expected_current_tag": {
          "type": "string",
          "minLength": 1
        },
        "exact_expected_current": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "readback": {
      "type": "object",
      "required": [
        "required",
        "policy"
      ],
      "properties": {
        "required": {
          "const": true
        },
        "policy": {
          "const": "exact_public_tag_latest_and_quality_disclosure"
        }
      },
      "additionalProperties": false
    },
    "authority_digest": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
