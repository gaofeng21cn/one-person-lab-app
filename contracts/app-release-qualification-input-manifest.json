{
  "schema": "opl_app_release_qualification_input_manifest.v1",
  "runtime_payloads": {
    "codex_cli": {
      "package": "@openai/codex",
      "platform": {
        "package": "@openai/codex",
        "os": "darwin",
        "cpu": "arm64",
        "binary_path": "package/vendor/aarch64-apple-darwin/bin/codex"
      },
      "dependency_id": "codex-cli",
      "selection_policy": "latest_stable_at_operation_start",
      "full_offline_seed": {
        "required": true,
        "materialization_role": "studio_owned_first_install_seed",
        "installation_owner": "one-person-lab",
        "archives": [
          "package",
          "platform"
        ],
        "offline_first_launch_requires_gateway": false,
        "existing_usable_codex_preserved": true,
        "permanent_version_pin": false
      }
    },
    "kimi_cu": {
      "provider_id": "kimi-cu",
      "product_name": "KimiCU",
      "license_spdx": "MIT",
      "redistribution_allowed": true,
      "platform": {
        "os": "macos",
        "minimum_version": "14.0",
        "architectures": [
          "arm64"
        ]
      },
      "bundle": {
        "bundle_id": "ai.kimi.cu",
        "team_id": "2J9472RW75",
        "signing": "developer_id",
        "notarization": "accepted",
        "target_install_path": "/Applications/KimiCU.app",
        "executable": "/Applications/KimiCU.app/Contents/MacOS/kimi-cu"
      },
      "mcp": {
        "args": [
          "mcp",
          "-s",
          "user"
        ],
        "required_tools": [
          "list_apps",
          "get_app_state",
          "click",
          "type_text",
          "press_key",
          "scroll",
          "set_value",
          "perform_secondary_action",
          "select_text",
          "drag"
        ]
      },
      "health": {
        "service_status_args": [
          "service-status"
        ],
        "xpc_ping_args": [
          "xpc-ping"
        ],
        "permission_status_args": [
          "doctor"
        ],
        "mcp_handshake": [
          "initialize",
          "tools/list",
          "tools/call:list_apps"
        ]
      },
      "dependency_id": "kimi-cu",
      "selection_policy": "latest_stable_at_operation_start"
    }
  },
  "release_boundary": {
    "release_qualification_must_consume_exact_identity": true,
    "moving_npm_dist_tags_forbidden": false,
    "build_cohort_and_attempt_receipt_binding_required": true,
    "moving_sources_must_resolve_before_candidate_freeze": true,
    "frozen_candidate_re_resolves_dependencies": false
  },
  "resolution": {
    "owner": "one-person-lab",
    "source_policy_ref": "one-person-lab/contracts/opl-framework/dependency-release-sources.json",
    "resolver": "one-person-lab/scripts/resolve-dependency-releases.mjs",
    "resolved_manifest_env": "OPL_RELEASE_DEPENDENCY_MANIFEST",
    "resolved_identity_is_operation_scoped": true,
    "permanent_version_pins_allowed": false,
    "preserve_verified_newer_installed_versions": true
  }
}
