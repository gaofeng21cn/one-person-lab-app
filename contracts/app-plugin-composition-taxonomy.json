{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onepersonlab.dev/contracts/app-plugin-composition-taxonomy.json",
  "schema_version": "opl_app_plugin_composition_taxonomy.v1",
  "owner": "one-person-lab-app",
  "purpose": "Separate development and delivery units from user-facing OPL App surfaces.",
  "authority_rule": "repository_location_and_carrier_do_not_choose_the_user_entry",
  "software_catalog": {
    "official_source_repository": "gaofeng21cn/opl-catalog",
    "visible_product_types": ["agent", "application", "extension", "channel"],
    "maintenance_type": "dependency",
    "type_owner": "package_manifest_or_native_plugin_inventory",
    "source_visibility_policy": "public_catalog_metadata_with_separate_owner_verified_artifact_access",
    "lifecycle_owner_policy": "route_each_action_to_the_actual_native_DSH_or_Framework_package_owner"
  },
  "layers": {
    "dsh_host_plugin": {
      "runtime_abi": "dsh_npm_package_cordis_host_plugin",
      "source_owner": "opl-studio",
      "composition_owner": "opl-studio_dsh_profile",
      "lifecycle": "App_bundled_baseline_with_native_DSH_profile_package_updates",
      "user_role": "application_host_service_or_transport",
      "may_be_user_visible": false,
      "examples": ["opl-codex-native", "opl-framework-bridge", "opl-mcp-apps"]
    },
    "dsh_client_plugin": {
      "runtime_abi": "dsh_client_module_and_slot_registry",
      "source_owner": "opl-studio",
      "composition_owner": "opl-studio_client_composition",
      "lifecycle": "official_DSH_client_module_graph_with_native_profile_override_and_restart_activation",
      "user_role": "shared_navigation_settings_or_workbench_surface",
      "may_be_user_visible": true,
      "examples": ["opl-studio-client", "opl-team-bots"]
    },
    "framework_capability_package": {
      "runtime_abi": "Framework_package_descriptor_native_carrier_and_app_contributions",
      "source_owner": "App_or_domain_package_owner",
      "composition_owner": "one-person-lab_Framework",
      "lifecycle": "owner_publication_and_native_carrier",
      "user_role": "professional_capability_provider_and_declarative_UI_contributor",
      "dsh_host_plugin": false,
      "examples": ["opl-channel-weixin", "domain_owned_packages"]
    },
    "standard_mcp_app_surface": {
      "runtime_abi": "MCP_Apps_SDK_AppBridge",
      "source_owner": "Framework_or_domain_package_owner",
      "composition_owner": "opl-studio_opl-mcp-apps_host",
      "lifecycle": "owner_package_and_current_thread_binding",
      "user_role": "operational_workspace_or_specialized_application_surface",
      "may_be_user_visible": true,
      "examples": ["shared_opl_apps", "domain_dedicated_mcp_app"]
    },
    "upstream_ecosystem_dependency": {
      "runtime_abi": "pinned_DSH_or_community_package_metadata",
      "source_owner": "upstream_owner",
      "composition_owner": "opl-studio_compatibility_adapter_when_needed",
      "lifecycle": "pinned_DSH_cohort_or_upstream_release",
      "user_role": "reused_UI_primitive_or_host_capability",
      "may_be_user_visible": true,
      "examples": ["dsh-client-modules", "dsh-settings-search"]
    }
  },
  "user_surface_routing": {
    "software_center": "install_update_enable_disable_remove_and_show_source_or_dependency",
    "settings": "persistent_configuration_connections_permissions_and_service_readiness",
    "application_workspace": "operational_lists_reviews_boards_timelines_artifacts_and_specialized_UI",
    "task_detail": "task_scoped_stages_artifacts_evidence_and_owner_actions",
    "runtime_maintenance": "provider_health_diagnostics_and_repair_guidance",
    "conversation": "ordinary_Codex_conversation_and_agent_selection"
  },
  "incremental_update_policy": {
    "package_identity_and_resolution_owner": "native_DSH_npm_metadata_profile_and_pnpm",
    "local_operator_entry": "npm run manual:plugins -- inspect|update-source|update-registry|remove",
    "target_profile": "opl-studio",
    "source_update_scope": "explicitly_selected_Studio_DSH_packages_only",
    "activation": "restart_App_then_verify_native_inventory_and_functional_readback",
    "cold_start_currentness": {
      "required_on_every_new_App_process": true,
      "version_resolution": "latest_verified_compatible_release_from_each_enabled_plugin_selected_native_channel",
      "activation_boundary": "before_Host_and_official_DSH_clientModules_graph_start",
      "compatible_old_runtime_is_a_user_choice": false,
      "running_process_plugin_bytes_replacement_allowed": false,
      "preserve_enabled_disabled_and_uninstalled_selection": true
    },
    "rollback": "native_DSH_remove_profile_dependency_to_restore_bundled_baseline",
    "app_bundle_mutation": false,
    "framework_package_lifecycle_mutation": false,
    "carrier_owned_shell_surfaces": ["electron", "pinned_dsh_core_cohort", "app_web_entry_boot_shell"],
    "upstream_cohort_changes_require_carrier_build": true,
    "independent_public_DSH_plugin_channel": {
      "registry": "github_packages_npm",
      "registry_url": "https://npm.pkg.github.com",
      "package_scope": "@gaofeng21cn",
      "version_strategy": "independent_semver_per_plugin",
      "engines_compatibility_field": "engines.dsh",
      "profile_constraint_format": "bundled_baseline_exact_pin_active_profile_semver_caret",
      "composition_test_before_stable": true,
      "composition_receipt_schema": "opl_dsh_plugin_composition_receipt.v1",
      "publishable_packages_include_client_modules": true,
      "excluded_packages": [],
      "design_and_operation_ref": "docs/delivery/dsh-plugin-publication.md",
      "implementation_status": "official_host_and_client_plugin_graph_profile_update_restart_activation_and_composition_admission_implemented",
      "verified_gaps": [
        "public_registry_publish_and_clean_machine_install_acceptance_still_require_a_real_release_run",
        "electron_dsh_core_cohort_and_app_web_entry_boot_shell_remain_carrier_bound",
        "feature_plugin_update_latency_requires_measurement_on_a_real_installed_app"
      ]
    },
    "plugin_first_stable_path": {
      "shell_unchanged": "composition_receipt_plus_profile_pin_update_plus_resign",
      "shell_changed": "full_build_consuming_registry_plugin_versions",
      "shell_identity_members": ["electron", "pinned_dsh_cohort", "app_web_entry_boot_shell"]
    },
    "runtime_client_composition": {
      "enabled_plugin_source": "native_DSH_profile_and_Cordis_Loader_entries",
      "discovery_source": "official_DSH_clientModules_scan_of_active_dsh_client_declarations",
      "graph_owner": "official_DSH_clientModules",
      "boot_owner": "official_DSH_AppWebEntry",
      "electron_transport_scope": "official_index_injections_and_advertised_plugins_resources",
      "separate_App_bundle_profile": false,
      "renderer_package_discovery": false,
      "release_composition_receipt_role": "evidence_of_one_tested_combination_not_runtime_discovery"
    },
    "currentness": "installed_and_running_native_package_identity_separate_from_App_bundle_version"
  },
  "uniformity_rules": [
    "user_surface_is_selected_by_functional_purpose_not_repository_package_role_or_catalog_scope",
    "all_package_UI_uses_app_admitted_declarative_contributions_or_the_standard_MCP_Apps_host",
    "all_package_actions_use_the_canonical_App_action_bridge_and_owner_readback",
    "package_installation_does_not_create_a_new_top_level_settings_navigation_entry",
    "App_and_client_do_not_maintain_a_second_package_registry_currentness_authority_or_domain_state_store"
  ],
  "repository_decision_rules": {
    "keep_in_opl_studio_when": [
      "the_unit_is_DSH_host_or_client_composition",
      "it_shares_the_Studio_profile_release_and_cross_plugin_test_cohort",
      "its_state_is_transport_or_host_lifecycle_state"
    ],
    "use_app_owned_package_when": [
      "the_capability_is_part_of_the_App_product",
      "it_needs_a_Framework_descriptor_and_native_carrier",
      "its_domain_logic_should_not_become_a_DSH_host_plugin"
    ],
    "use_independent_domain_repo_when": [
      "the_capability_has_an_independent_domain_owner",
      "it_has_its_own_publication_or_release_cadence",
      "it_can_be_consumed_by_more_than_one_product_or_host"
    ],
    "do_not_split_or_merge_only_because": [
      "a_directory_is_named_plugins",
      "a_package_has_a_Codex_plugin_carrier",
      "a_feature_contributes_a_user_facing_view"
    ]
  },
  "source_ownership_policy": {
    "status": "plugin_source_boundaries_implemented",
    "purpose": "Make each independently published DSH package understandable and buildable from its own public exports without creating a second plugin ABI or loader.",
    "target_regions": {
      "apps": {
        "responsibility": "Electron carrier, preload, restricted resource bridge, AppWebEntry boot shell and DSH profile composition",
        "current_location": "opl-studio/desktop, src/main.tsx, src/bridge/webTransport.ts and src/host",
        "migration_status": "carrier_paths_retained"
      },
      "plugins": {
        "responsibility": "Independently published DSH Host and Client npm packages, including package-local source and generated lib output",
        "current_location": "opl-studio/plugins/<plugin-id>",
        "migration_status": "grouped_layout_required_for_the_next_Studio_cohort",
        "target_location": "opl-studio/plugins/{core,extensions,channels}/<plugin-id>",
        "groups": {
          "core": "bundled_runtime_and_host_infrastructure",
          "extensions": "Workbench_and_workflow_features",
          "channels": "built_in_connection_transports"
        }
      },
      "packages": {
        "responsibility": "Small shared contracts, Host primitives and DSH compatibility adapters justified by current callers and a stable public interface",
        "target_units": ["host-contracts", "host-kit", "dsh-adapters"],
        "current_location": "opl-studio/packages/host-contracts, packages/host-kit and packages/dsh-adapters",
        "migration_status": "shared_implementations_consumed_through_public_entrypoints"
      },
      "vendor": {
        "responsibility": "Pinned upstream DSH and Superagent source kept separate from OPL-owned source",
        "current_location": "opl-studio/vendor",
        "migration_status": "upstream_sources_owned_by_vendor"
      }
    },
    "dependency_direction": {
      "allowed": [
        "apps_to_plugin_public_exports",
        "apps_to_packages_public_exports",
        "plugins_to_packages_public_exports",
        "plugins_to_official_dsh_packages",
        "packages_to_base_libraries_and_official_dsh_packages",
        "packages_or_the_owning_plugin_to_vendor"
      ],
      "forbidden": [
        "plugin_to_root_src_relative_import",
        "plugin_to_sibling_plugin_src_import",
        "root_workbench_to_plugin_internal_src_import",
        "runtime_plugin_to_scripts_import",
        "vendor_to_opl_owned_runtime_source_import",
        "shared_package_as_a_second_aggregate_plugin"
      ],
      "public_boundary": "Cross-region and cross-plugin imports use package exports, explicit contracts or typed adapters; internal src paths are not a supported API."
    },
    "generated_output": {
      "lib_is_generated": true,
      "source_of_truth": "plugin source and build inputs",
      "handwritten_lib_allowed": false,
      "publish_input": "package-local generated lib selected by the package files field",
      "cleanliness_rule": "build and release checks distinguish generated lib from editable source"
    },
    "transition_rules": {
      "implemented_boundaries": [
        "shared_bridge_MCP_Apps_thread_Team_and_Superagent_types_owned_by_host_contracts",
        "Host_Core_consumes_Cordis_injected_services_without_sibling_internal_service_imports",
        "native_profile_update_runtime_owned_by_host_kit_with_CLI_build_and_pack_kept_in_scripts",
        "Studio_Client_owns_the_Workbench_client_composition_and_slot_adapters",
        "product_client_policy_shipped_in_the_client_factory_instead_of_static_HTML",
        "shared_DSH_workspace_preview_reused_by_Studio_Client_and_MCP_Apps"
      ],
      "do_not_claim_complete_until": [
        "all production imports obey dependency_direction",
        "each extracted shared package has a justified shared ownership boundary and documented public exports",
        "the old root or sibling internal import has no production caller",
        "focused package build and package-outside-checkout runtime tests pass"
      ],
      "migration_order": [
        "extract only pure contracts and ABI types first",
        "extract host-kit primitives only after repeated shared callers are identified",
        "move client composition and client-only integrations into opl-studio-client behind public exports",
        "switch Host callers to sibling package exports before deleting transitional root modules",
        "retire scripts from runtime imports and keep update tooling as an operator boundary"
      ],
      "preserve": [
        "official DSH dsh.client discovery and AppWebEntry loading",
        "native profile ownership and restart activation",
        "Framework and Codex state/action ownership",
        "independent plugin publication and composition evidence"
      ]
    }
  },
  "inventory": {
    "command": "node scripts/plugin-composition-inventory.mjs --studio-root <path> [--catalog-index <path>]",
    "source_of_truth": "Studio_profile_and_package_manifests_plus_the_frozen_official_software_catalog",
    "static_package_allowlist": false,
    "installation_claim": "inventory_describes_source_and_declared_composition_only"
  }
}
