{
  "schema_version": "opl.release.v1",
  "subject_id": "opl-app",
  "kind": "product",
  "repository": "gaofeng21cn/one-person-lab-app",
  "schedule": "owner_schedule",
  "trigger": "owner_schedule",
  "lanes": [
    {
      "lane": "nightly",
      "workflow": "release-nightly.yml",
      "primary": true,
      "daily_dispatch": true,
      "channel": {
        "kind": "github_prerelease",
        "tag_pattern": "v[0-9]+\\.[0-9]+\\.[0-9]+-nightly(\\.r[0-9]+)?"
      }
    },
    {
      "lane": "stable",
      "workflow": "release-stable.yml",
      "primary": false,
      "title_pattern": " (standard operation:|resume_standard source:|Studio release ref:)",
      "channel": {
        "kind": "github_release"
      }
    },
    {
      "lane": "stable-full",
      "workflow": "release-stable.yml",
      "primary": false,
      "title_pattern": " (append_full source:|Studio Full append ref:)",
      "channel": {
        "kind": "github_release",
        "asset_pattern": "One-Person-Lab-Full-.*-mac-arm64\\.dmg"
      }
    }
  ]
}
